#!/usr/bin/env bash

dotlink() {
  if [[ $# -ne 1 || -z "$1" ]]; then
    printf 'Usage: dotlink PATH_WITHIN_HOME\n' >&2
    return 2
  fi

  local rel src dst parent backup stamp n

  # Accept either an absolute path under $HOME or a home-relative path.
  case "$1" in
    "$HOME"/*) rel=${1#"$HOME"/} ;;
    /*)
      printf 'Path must be inside %s: %s\n' "$HOME" "$1" >&2
      return 2
      ;;
    *) rel=$1 ;;
  esac

  # Reject paths that could escape $HOME or refer to the dotfiles repo itself.
  case "/$rel/" in
    */../*)
      printf 'Path must not contain "..": %s\n' "$1" >&2
      return 2
      ;;
  esac
  case "$rel" in
    .dotfiles|.dotfiles/*)
      printf 'Path must not be inside the .dotfiles directory: %s\n' "$1" >&2
      return 2
      ;;
  esac

  src="$HOME/.dotfiles/$rel"
  dst="$HOME/$rel"
  parent=${dst%/*}

  if [[ ! -f "$src" && ! -d "$src" ]]; then
    printf 'Source is not an existing file or directory: %s\n' "$src" >&2
    return 1
  fi

  # Make repeated calls harmless when this exact link already exists.
  if [[ -L "$dst" && "$(readlink "$dst")" == "$src" ]]; then
    printf 'Already linked: %s -> %s\n' "$dst" "$src"
    return 0
  fi

  mkdir -p -- "$parent" || return 1

  backup=""
  if [[ -e "$dst" || -L "$dst" ]]; then
    if [[ ! -f "$dst" && ! -d "$dst" && ! -L "$dst" ]]; then
      printf 'Target is not a regular file, directory, or symlink: %s\n' "$dst" >&2
      return 1
    fi

    stamp=$(date +%Y%m%d-%H%M%S) || return 1
    backup="$dst.bak.$stamp"
    n=1
    while [[ -e "$backup" || -L "$backup" ]]; do
      backup="$dst.bak.$stamp.$n"
      n=$((n + 1))
    done

    mv -- "$dst" "$backup" || return 1
    printf 'Moved existing target to %s\n' "$backup"
  fi

  if ! ln -s -- "$src" "$dst"; then
    printf 'Could not create symlink: %s\n' "$dst" >&2
    if [[ -n "$backup" ]]; then
      mv -- "$backup" "$dst" ||
        printf 'Could not restore backup: %s\n' "$backup" >&2
    fi
    return 1
  fi

  printf 'Linked %s -> %s\n' "$dst" "$src"
}

# if [ ! -d ~/.vim/bundle/fzf ]; then
#   git clone https://github.com/junegunn/fzf.git
#   ~/.vim/bundle/fzf/install \
#     --no-key-bindings \
#     --no-completion \
#     --no-update-rc
#   . ~/.fzf.bash
# fi

# if [ ! -d ~/.vim/bundle/fzf.vim ]; then
#   git clone https://github.com/junegunn/fzf.vim.git
# fi

dotlink "$HOME/.bash_profile" || exit 1
dotlink "$HOME/.bashrc" || exit 1
dotlink "$HOME/.eslintrc" || exit 1
dotlink "$HOME/.gitconfig" || exit 1
dotlink "$HOME/.npmrc" || exit 1
dotlink "$HOME/.ripgreprc" || exit 1
dotlink "$HOME/.screenrc" || exit 1
dotlink "$HOME/.stylelintrc.json" || exit 1
dotlink "$HOME/.vimrc" || exit 1

dotlink "$HOME/.config/ghostty" || exit 1
dotlink "$HOME/.config/nvim" || exit 1

if [ ! -f ~/.gitconfig.local ]; then
  touch ~/.gitconfig.local
fi

if [ ! -f ~/.screenrc.local ]; then
  touch ~/.screenrc.local
fi
